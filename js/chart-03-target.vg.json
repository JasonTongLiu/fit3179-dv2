{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "data/target-progress.csv"},
  "width": "container",
  "height": 245,
  "padding": {"left": 8, "right": 28, "top": 5, "bottom": 5},
  "autosize": {"type": "fit", "contains": "padding", "resize": true},
  "encoding": {
    "y": {"field": "label", "type": "nominal", "title": null, "sort": ["2018–2020 baseline", "2025 observed", "2030 target"], "axis": {"labelLimit": 175, "labelPadding": 7}}
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 3},
      "encoding": {
        "x": {"field": "deaths", "type": "quantitative", "title": "Road deaths", "scale": {"domain": [0, 1500]}},
        "color": {"field": "label", "type": "nominal", "legend": null, "scale": {"domain": ["2018–2020 baseline","2025 observed","2030 target"], "range": ["#93a5ad","#17324d","#c84c33"]}},
        "tooltip": [
          {"field": "label", "type": "nominal", "title": "Measure"},
          {"field": "deaths", "type": "quantitative", "title": "Road deaths", "format": ",.0f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 5, "fontWeight": "bold", "fontSize": 11},
      "encoding": {
        "x": {"field": "deaths", "type": "quantitative", "scale": {"domain": [0, 1500]}},
        "text": {"field": "deaths", "type": "quantitative", "format": ",.0f"},
        "color": {"value": "#17252f"}
      }
    }
  ],
  "config": {"view": {"stroke": null}, "axis": {"gridColor": "#d9e3e4", "labelColor": "#53636d", "titleColor": "#53636d"}}
}
